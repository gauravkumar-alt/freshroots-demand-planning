# Supabase (shared storage for decisions, audit log, uploads). Run supabase/schema.sql once in the SQL editor.
# Without these, the server keeps data in memory only (fine for local development, lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (trends + highlights). Without a key the app shows rule-generated highlights.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Zoho Inventory (PO on approval). Without all of these, POs are simulated.
# api-console.zoho.in → Self Client → scopes:
#   ZohoInventory.purchaseorders.CREATE,ZohoInventory.items.READ
# (a Zoho CRM token will not work: Inventory needs its own scopes)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=in
ZOHO_ORG_ID=
ZOHO_VENDOR_ID=

# Kill-switch email via Resend. Without both, the app shows the email it would have sent.
RESEND_API_KEY=
EMAIL_FROM=Freshroots Planning <onboarding@resend.dev>
KILL_SWITCH_EMAIL=you@example.com

APP_URL=http://localhost:3400
